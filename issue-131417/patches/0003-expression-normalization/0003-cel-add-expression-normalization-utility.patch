+package cel
+
+import (
+	"strings"
+	"unicode"
+)
+
+// NormalizeExpression returns a canonical form of the given CEL expression
+// suitable for use as a key in compilation caches.
+//
+// Normalization improves cache hit rates by collapsing cosmetically-different
+// but semantically identical expressions into the same string. It is
+// intentionally conservative:
+//
+//   - Leading and trailing whitespace are removed.
+//   - Trailing whitespace on each internal line is removed.
+//   - Windows-style CRLF line endings are converted to LF.
+//   - Internal whitespace inside a line, and whitespace inside string
+//     literals, are preserved verbatim. This is critical because changing
+//     them could shift the line/column positions surfaced by cel-go in
+//     compilation error messages, breaking error UX.
+//
+// The transform is idempotent: NormalizeExpression(NormalizeExpression(s))
+// equals NormalizeExpression(s) for all s.
+//
+// This function is safe to call concurrently and is allocation-free for
+// expressions that are already in canonical form.
+func NormalizeExpression(expr string) string {
+	if expr == "" {
+		return expr
+	}
+
+	// Fast path: scan once. If the expression is already canonical (no CR,
+	// no leading/trailing whitespace overall, no trailing whitespace on any
+	// line), return it unchanged.
+	if isAlreadyCanonical(expr) {
+		return expr
+	}
+
+	// Slow path. Build the normalized result.
+	expr = strings.TrimSpace(expr)
+	if !strings.ContainsAny(expr, "\r\n") {
+		return expr
+	}
+
+	var b strings.Builder
+	b.Grow(len(expr))
+	for i := 0; i < len(expr); {
+		// Find next end-of-line.
+		j := i
+		for j < len(expr) && expr[j] != '\n' && expr[j] != '\r' {
+			j++
+		}
+		// Trim trailing whitespace within the line.
+		end := j
+		for end > i && isASCIIWhitespace(expr[end-1]) {
+			end--
+		}
+		b.WriteString(expr[i:end])
+		// Handle line terminator.
+		if j < len(expr) {
+			if expr[j] == '\r' && j+1 < len(expr) && expr[j+1] == '\n' {
+				b.WriteByte('\n')
+				j += 2
+			} else if expr[j] == '\r' {
+				b.WriteByte('\n')
+				j++
+			} else { // '\n'
+				b.WriteByte('\n')
+				j++
+			}
+		}
+		i = j
+	}
+	// TrimSpace already removed surrounding whitespace; the loop preserved
+	// internal newlines but may have left a trailing '\n' if the original
+	// input ended on a blank line that survived TrimSpace. Trim once more
+	// for idempotency.
+	return strings.TrimRightFunc(b.String(), unicode.IsSpace)
+}
+
+// isAlreadyCanonical reports whether s satisfies the contract of
+// NormalizeExpression without any modification.
+func isAlreadyCanonical(s string) bool {
+	if s == "" {
+		return true
+	}
+	if isASCIIWhitespace(s[0]) || isASCIIWhitespace(s[len(s)-1]) {
+		return false
+	}
+	prevWasNL := false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c == '\r' {
+			return false
+		}
+		if c == '\n' {
+			if prevWasNL {
+				// Two consecutive newlines mean the previous line ended on
+				// a blank line — not necessarily non-canonical, but our
+				// trailing-whitespace rule allows it. We continue.
+			}
+			// Check that the byte before this newline (if any, on this
+			// line) is not whitespace.
+			if i > 0 && isASCIIWhitespace(s[i-1]) {
+				return false
+			}
+			prevWasNL = true
+			continue
+		}
+		prevWasNL = false
+	}
+	return true
+}
+
+func isASCIIWhitespace(b byte) bool {
+	switch b {
+	case ' ', '\t', '\n', '\r', '\v', '\f':
+		return true
+	}
+	return false
+}
