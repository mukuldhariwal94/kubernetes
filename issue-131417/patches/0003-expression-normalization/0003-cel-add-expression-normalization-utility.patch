+package cel
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestNormalizeExpression(t *testing.T) {
+	cases := []struct {
+		name string
+		in   string
+		want string
+	}{
+		{"empty", "", ""},
+		{"already canonical", "object.x > 0", "object.x > 0"},
+		{"trims leading whitespace", "  object.x > 0", "object.x > 0"},
+		{"trims trailing whitespace", "object.x > 0\n", "object.x > 0"},
+		{"trims both", "  object.x > 0\t\n", "object.x > 0"},
+		{"preserves internal whitespace", "object.x  >  0", "object.x  >  0"},
+		{"converts CRLF to LF", "object.x > 0\r\nfoo == 'bar'", "object.x > 0\nfoo == 'bar'"},
+		{"converts standalone CR to LF", "object.x > 0\rfoo == 'bar'", "object.x > 0\nfoo == 'bar'"},
+		{"trims trailing whitespace per line", "object.x > 0   \n  foo == 'bar'  \n", "object.x > 0\n  foo == 'bar'"},
+		{"preserves whitespace inside string literal", "object.x == 'a   b'", "object.x == 'a   b'"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := NormalizeExpression(c.in)
+			if got != c.want {
+				t.Errorf("NormalizeExpression(%q) = %q, want %q", c.in, got, c.want)
+			}
+		})
+	}
+}
+
+func TestNormalizeExpression_Idempotent(t *testing.T) {
+	inputs := []string{
+		"",
+		"object.x > 0",
+		"  object.x > 0  ",
+		"object.x > 0\r\nfoo == 'bar'\n",
+		"  object.x > 0   \n  foo == 'bar'  \n",
+	}
+	for _, in := range inputs {
+		once := NormalizeExpression(in)
+		twice := NormalizeExpression(once)
+		if once != twice {
+			t.Errorf("not idempotent: NormalizeExpression(%q) = %q; second pass produced %q", in, once, twice)
+		}
+	}
+}
+
+func TestNormalizeExpression_LeavesAlreadyCanonicalUnchanged(t *testing.T) {
+	in := "object.spec.replicas > 0 && object.spec.replicas < 10"
+	out := NormalizeExpression(in)
+	// Identity match (same backing string when fast-path triggers) is not
+	// guaranteed by the API, but the value must be byte-for-byte equal.
+	if out != in {
+		t.Errorf("expected canonical input unchanged, got %q", out)
+	}
+}
+
+func BenchmarkNormalizeExpression_Canonical(b *testing.B) {
+	in := strings.Repeat("object.spec.replicas > 0 && ", 20) + "true"
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		_ = NormalizeExpression(in)
+	}
+}
+
+func BenchmarkNormalizeExpression_NeedsNormalization(b *testing.B) {
+	in := "  " + strings.Repeat("object.spec.replicas > 0 && ", 20) + "true   \r\n"
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		_ = NormalizeExpression(in)
+	}
+}
