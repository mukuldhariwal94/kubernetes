+// buildEnv constructs the EnvSet for opts. When the compiler is wired to a
+// process-wide matrix pool it reuses the shared (template, opts) entry and
+// Extends the per-policy `variables` overlay (if any) on top — so two policies
+// whose only difference is their `variables` declarations still share the
+// underlying matrix. Otherwise it builds the entry from this compiler's own
+// base env (the standalone NewCompiler path).
+func (c compiler) buildEnv(opts OptionalVariableDeclarations) (*environment.EnvSet, error) {
+	if c.sharedMatrix != nil {
+		shared, err := c.sharedMatrix.envFor(opts)
+		if err != nil {
+			return nil, err
+		}
+		if c.variablesOverlay == nil {
+			return shared, nil
+		}
+		return shared.Extend(*c.variablesOverlay)
+	}
+	return createEnvForOpts(c.base, c.namespace, c.request, opts)
+}
