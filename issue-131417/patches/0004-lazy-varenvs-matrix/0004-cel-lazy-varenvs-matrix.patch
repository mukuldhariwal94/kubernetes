+// createEnvForOpts builds the EnvSet for a single OptionalVariableDeclarations
+// combination. It is the single point where a per-(opts) environment is
+// materialized; compiler.envFor now invokes it lazily on first use rather than
+// mustBuildEnvs eagerly precomputing the full 8-entry Cartesian product.
 func createEnvForOpts(baseEnv *environment.EnvSet, namespaceType *apiservercel.DeclType, requestType *apiservercel.DeclType, opts OptionalVariableDeclarations) (*environment.EnvSet, error) {
 	var envOpts []cel.EnvOption
 	envOpts = append(envOpts,
