-type variableDeclEnvs map[OptionalVariableDeclarations]*environment.EnvSet
+// envFor returns the EnvSet for the given OptionalVariableDeclarations,
+// constructing it on first use. Concurrent callers requesting the same key
+// share one construction via sync.Once; concurrent callers requesting
+// different keys make progress independently. Replaces the eager 8-entry
+// matrix that mustBuildEnvs used to materialize for every compiler — in
+// production VAP only ever asks for 2 of those 8 combinations and MAP for 4.
+func (c compiler) envFor(opts OptionalVariableDeclarations) (*environment.EnvSet, error) {
+	if v, ok := c.envs.Load(opts); ok {
+		return v.(*environment.EnvSet), nil
+	}
+	onceI, _ := c.once.LoadOrStore(opts, &sync.Once{})
+	var buildErr error
+	onceI.(*sync.Once).Do(func() {
+		es, err := createEnvForOpts(c.base, c.namespace, c.request, opts)
+		if err != nil {
+			buildErr = err
+			return
+		}
+		c.envs.Store(opts, es)
+	})
+	if buildErr != nil {
+		// Allow a future caller to retry by clearing the once entry. This
+		// matches the previous eager semantics, where a transient
+		// configuration error would surface at every compile attempt.
+		c.once.Delete(opts)
+		return nil, buildErr
+	}
+	v, _ := c.envs.Load(opts)
+	return v.(*environment.EnvSet), nil
+}
 
 // CompileCELExpression returns a compiled CEL expression.
 // perCallLimit was added for testing purpose only. Callers should always use const PerCallLimit from k8s.io/apiserver/pkg/apis/cel/config.go as input.
