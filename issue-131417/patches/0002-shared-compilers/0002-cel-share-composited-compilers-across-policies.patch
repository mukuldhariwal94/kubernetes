+package cel
+
+import (
+	"sort"
+	"strings"
+	"sync/atomic"
+
+	"k8s.io/apiserver/pkg/cel/environment"
+	"k8s.io/utils/lru"
+)
+
+// defaultCompositedCompilerCacheSize bounds how many distinct
+// CompositedCompiler instances are kept process-wide. Each entry holds the
+// 9-env machinery and the compiled variable programs for one structural
+// "compilation profile" (env template + variable declarations + opts).
+//
+// The dominant cost per VAP/MAP today is the per-policy creation of this
+// machinery; capping the cache at 1000 entries comfortably accommodates
+// hundreds of distinct variable signatures while bounding memory.
+const defaultCompositedCompilerCacheSize = 1000
+
+var (
+	// globalCompositedCompilerCache is swapped via atomic.Pointer so callers
+	// can read it lock-free.
+	globalCompositedCompilerCache atomic.Pointer[lru.Cache]
+
+	compositedCompilerCacheHits   atomic.Int64
+	compositedCompilerCacheMisses atomic.Int64
+)
+
+func init() {
+	globalCompositedCompilerCache.Store(lru.New(defaultCompositedCompilerCacheSize))
+}
+
+func compositedCompilerCache() *lru.Cache {
+	return globalCompositedCompilerCache.Load()
+}
+
+// CompositedCompilerCacheStats reports current cache stats.
+type CompositedCompilerCacheStats struct {
+	Size   int
+	Hits   int64
+	Misses int64
+}
+
+// GetCompositedCompilerCacheStats returns current cache stats.
+func GetCompositedCompilerCacheStats() CompositedCompilerCacheStats {
+	return CompositedCompilerCacheStats{
+		Size:   compositedCompilerCache().Len(),
+		Hits:   compositedCompilerCacheHits.Load(),
+		Misses: compositedCompilerCacheMisses.Load(),
+	}
+}
+
+// SetCompositedCompilerCacheSizeForTests replaces the process-wide cache with
+// one of the given size and returns a func that restores the previous one.
+// Test only.
+func SetCompositedCompilerCacheSizeForTests(size int) func() {
+	prev := globalCompositedCompilerCache.Load()
+	prevHits := compositedCompilerCacheHits.Load()
+	prevMisses := compositedCompilerCacheMisses.Load()
+	globalCompositedCompilerCache.Store(lru.New(size))
+	compositedCompilerCacheHits.Store(0)
+	compositedCompilerCacheMisses.Store(0)
+	return func() {
+		globalCompositedCompilerCache.Store(prev)
+		compositedCompilerCacheHits.Store(prevHits)
+		compositedCompilerCacheMisses.Store(prevMisses)
+	}
+}
+
+// compositedCompilerCacheKey identifies a structurally unique
+// CompositedCompiler "shape": the env template plus the variable declarations
+// (and the options under which they're compiled).
+//
+// Two policies that share the same envTemplate, varSig, opts and envType can
+// safely share a CompositedCompiler instance because:
+//   - the underlying *environment.EnvSet, the 9-env matrix, and the variable
+//     programs depend only on these inputs;
+//   - the per-policy work after CompileAndStoreVariables (CompileCondition /
+//     CompileMutatingEvaluator) returns *new* per-call evaluators and never
+//     mutates the shared compositionState.
+//
+// The struct is comparable so it can be used directly as an lru.Cache key.
+type compositedCompilerCacheKey struct {
+	envTemplate *environment.EnvSet
+	varSig      string
+	opts        OptionalVariableDeclarations
+	envType     environment.Type
+}
+
+// GetOrCreateCompositedCompiler returns a process-wide cached *CompositedCompiler
+// initialized with the provided variables already compiled. Callers MUST treat
+// the returned compiler as read-only with respect to variable storage —
+// CompileAndStoreVariables must not be called on it.
+//
+// On a cache hit, the per-policy work of constructing a CompositedCompiler
+// (which performs ~9 expensive env.Extend operations and compiles every
+// variable expression) is entirely skipped. Per-policy condition compilation
+// is unaffected and continues to produce per-call evaluators.
+//
+// envTemplate must be a stable identity — typically the singleton returned by
+// the caller's compilation environment template (e.g.
+// `getCompositionEnvTemplateWithStrictCost()` in the validating plugin).
+func GetOrCreateCompositedCompiler(
+	envTemplate *environment.EnvSet,
+	variables []NamedExpressionAccessor,
+	opts OptionalVariableDeclarations,
+	envType environment.Type,
+) (*CompositedCompiler, error) {
+	key := compositedCompilerCacheKey{
+		envTemplate: envTemplate,
+		varSig:      computeVariableDeclSignature(variables),
+		opts:        opts,
+		envType:     envType,
+	}
+
+	if cached, ok := compositedCompilerCache().Get(key); ok {
+		if cc, ok := cached.(*CompositedCompiler); ok {
+			compositedCompilerCacheHits.Add(1)
+			return cc, nil
+		}
+	}
+
+	cc, err := NewCompositedCompiler(envTemplate)
+	if err != nil {
+		return nil, err
+	}
+	cc.CompileAndStoreVariables(variables, opts, envType)
+	compositedCompilerCache().Add(key, cc)
+	compositedCompilerCacheMisses.Add(1)
+	return cc, nil
+}
+
+// computeVariableDeclSignature returns a deterministic structural fingerprint
+// of a list of variable declarations. Two slices that declare the same set of
+// variables (same names, same expressions) — regardless of declaration order —
+// produce the same signature.
+//
+// We sort by name to make the signature insensitive to user reordering, which
+// would otherwise pessimize the cache.
+func computeVariableDeclSignature(variables []NamedExpressionAccessor) string {
+	if len(variables) == 0 {
+		return ""
+	}
+	type nameExpr struct{ name, expr string }
+	pairs := make([]nameExpr, 0, len(variables))
+	for _, v := range variables {
+		if v == nil {
+			continue
+		}
+		pairs = append(pairs, nameExpr{name: v.GetName(), expr: v.GetExpression()})
+	}
+	sort.Slice(pairs, func(i, j int) bool {
+		if pairs[i].name != pairs[j].name {
+			return pairs[i].name < pairs[j].name
+		}
+		return pairs[i].expr < pairs[j].expr
+	})
+	var b strings.Builder
+	for _, p := range pairs {
+		// Length-prefixed framing protects against name|expr collisions
+		// (e.g. {name:"a", expr:"b|c"} vs {name:"a|b", expr:"c"}).
+		writeStringWithLen(&b, p.name)
+		b.WriteByte('=')
+		writeStringWithLen(&b, p.expr)
+		b.WriteByte('\n')
+	}
+	return b.String()
+}
+
+func writeStringWithLen(b *strings.Builder, s string) {
+	// Write a small prefix so two adjacent fields can't merge into one. We use
+	// a decimal length followed by ':' which is short and human-readable in
+	// debug dumps of the cache key.
+	itoaInto(b, len(s))
+	b.WriteByte(':')
+	b.WriteString(s)
+}
+
+func itoaInto(b *strings.Builder, n int) {
+	if n == 0 {
+		b.WriteByte('0')
+		return
+	}
+	var buf [20]byte
+	i := len(buf)
+	for n > 0 {
+		i--
+		buf[i] = byte('0' + n%10)
+		n /= 10
+	}
+	b.Write(buf[i:])
+}
