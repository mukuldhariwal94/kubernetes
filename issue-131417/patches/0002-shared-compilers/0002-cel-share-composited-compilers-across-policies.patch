+)
+
+// fakeNamedAccessor is a minimal NamedExpressionAccessor for tests that
+// doesn't drag in the validating package.
+type fakeNamedAccessor struct {
+	name string
+	expr string
+}
+
+func (f *fakeNamedAccessor) GetName() string             { return f.name }
+func (f *fakeNamedAccessor) GetExpression() string       { return f.expr }
+func (f *fakeNamedAccessor) ReturnTypes() []*celgo.Type  { return []*celgo.Type{celgo.AnyType} }
+
+func TestGetOrCreateCompositedCompiler_ReusesAcrossPoliciesWithSameVariables(t *testing.T) {
+	restore := SetCompositedCompilerCacheSizeForTests(64)
+	defer restore()
+
+	envTemplate := environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion())
+	vars := []NamedExpressionAccessor{
+		&fakeNamedAccessor{name: "x", expr: "1"},
+		&fakeNamedAccessor{name: "y", expr: "object.kind"},
+	}
+	opts := OptionalVariableDeclarations{HasParams: false, HasAuthorizer: true}
+
+	c1, err := GetOrCreateCompositedCompiler(envTemplate, vars, opts, environment.StoredExpressions)
+	if err != nil {
+		t.Fatalf("first call errored: %v", err)
+	}
+	c2, err := GetOrCreateCompositedCompiler(envTemplate, vars, opts, environment.StoredExpressions)
+	if err != nil {
+		t.Fatalf("second call errored: %v", err)
+	}
+
+	if c1 != c2 {
+		t.Fatalf("expected the same *CompositedCompiler pointer to be reused, got distinct instances")
+	}
+	if got, want := GetCompositedCompilerCacheStats().Hits, int64(1); got != want {
+		t.Errorf("expected %d hit, got %d", want, got)
+	}
+	if got, want := GetCompositedCompilerCacheStats().Misses, int64(1); got != want {
+		t.Errorf("expected %d miss, got %d", want, got)
+	}
+}
+
+func TestGetOrCreateCompositedCompiler_NoVariablesAllShare(t *testing.T) {
+	restore := SetCompositedCompilerCacheSizeForTests(64)
+	defer restore()
+
+	envTemplate := environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion())
+	opts := OptionalVariableDeclarations{HasAuthorizer: true}
+
+	c1, _ := GetOrCreateCompositedCompiler(envTemplate, nil, opts, environment.StoredExpressions)
+	c2, _ := GetOrCreateCompositedCompiler(envTemplate, []NamedExpressionAccessor{}, opts, environment.StoredExpressions)
+	c3, _ := GetOrCreateCompositedCompiler(envTemplate, nil, opts, environment.StoredExpressions)
+
+	if c1 != c2 || c2 != c3 {
+		t.Errorf("expected all three to share an instance (no variables), got %p %p %p", c1, c2, c3)
+	}
+}
+
+func TestGetOrCreateCompositedCompiler_DifferentVariablesDoNotShare(t *testing.T) {
+	restore := SetCompositedCompilerCacheSizeForTests(64)
+	defer restore()
+
+	envTemplate := environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion())
+	opts := OptionalVariableDeclarations{HasAuthorizer: true}
+
+	a := []NamedExpressionAccessor{&fakeNamedAccessor{name: "x", expr: "1"}}
+	b := []NamedExpressionAccessor{&fakeNamedAccessor{name: "x", expr: "2"}}
+
+	ca, _ := GetOrCreateCompositedCompiler(envTemplate, a, opts, environment.StoredExpressions)
+	cb, _ := GetOrCreateCompositedCompiler(envTemplate, b, opts, environment.StoredExpressions)
+
+	if ca == cb {
+		t.Errorf("expected distinct compilers for differing variable expressions; got %p == %p", ca, cb)
+	}
+}
+
+func TestGetOrCreateCompositedCompiler_OrderInsensitiveVariables(t *testing.T) {
+	restore := SetCompositedCompilerCacheSizeForTests(64)
+	defer restore()
+
+	envTemplate := environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion())
+	opts := OptionalVariableDeclarations{HasAuthorizer: true}
+
+	abc := []NamedExpressionAccessor{
+		&fakeNamedAccessor{name: "a", expr: "1"},
+		&fakeNamedAccessor{name: "b", expr: "2"},
+	}
+	bac := []NamedExpressionAccessor{
+		&fakeNamedAccessor{name: "b", expr: "2"},
+		&fakeNamedAccessor{name: "a", expr: "1"},
+	}
+
+	c1, _ := GetOrCreateCompositedCompiler(envTemplate, abc, opts, environment.StoredExpressions)
+	c2, _ := GetOrCreateCompositedCompiler(envTemplate, bac, opts, environment.StoredExpressions)
+	if c1 != c2 {
+		t.Errorf("variable order should not affect compiler identity, got %p != %p", c1, c2)
+	}
+}
+
+func TestGetOrCreateCompositedCompiler_DifferentOptsDoNotShare(t *testing.T) {
+	restore := SetCompositedCompilerCacheSizeForTests(64)
+	defer restore()
+
+	envTemplate := environment.MustBaseEnvSet(environment.DefaultCompatibilityVersion())
+	c1, _ := GetOrCreateCompositedCompiler(envTemplate, nil, OptionalVariableDeclarations{HasParams: false}, environment.StoredExpressions)
+	c2, _ := GetOrCreateCompositedCompiler(envTemplate, nil, OptionalVariableDeclarations{HasParams: true}, environment.StoredExpressions)
+	if c1 == c2 {
+		t.Errorf("expected distinct compilers for different OptionalVariableDeclarations, got %p == %p", c1, c2)
+	}
+}
