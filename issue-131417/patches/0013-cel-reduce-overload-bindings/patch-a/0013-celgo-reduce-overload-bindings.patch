+// HasOverloadID reports whether the function declares an overload with the given ID.
+// Uses the internal map directly — O(1), no slice allocation.
+func (f *FunctionDecl) HasOverloadID(id string) bool {
+	if f == nil {
+		return false
+	}
+	_, ok := f.overloads[id]
+	return ok
+}
