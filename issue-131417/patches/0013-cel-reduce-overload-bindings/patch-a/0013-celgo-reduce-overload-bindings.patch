+// fnOverlapsOIDs reports whether fn declares at least one overload whose ID
+// appears in usedOIDs. It iterates usedOIDs (typically 5–20 entries) and calls
+// fn.HasOverloadID for each, avoiding the slice allocation of OverloadDecls().
+func fnOverlapsOIDs(fn *decls.FunctionDecl, usedOIDs map[string]struct{}) bool {
+	for oID := range usedOIDs {
+		if fn.HasOverloadID(oID) {
+			return true
+		}
+	}
+	return false
+}
