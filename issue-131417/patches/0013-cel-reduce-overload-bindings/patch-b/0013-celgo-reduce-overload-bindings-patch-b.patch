+// overloadIndex returns a map from overload ID to the FunctionDecl that declares it.
+// The map is built once per Env (O(total overloads)) and reused by every newProgram
+// call, so each program compilation only pays O(|usedOIDs|) for binding selection.
+func (e *Env) overloadIndex() map[string]*decls.FunctionDecl {
+	e.oidToFnOnce.Do(func() {
+		idx := make(map[string]*decls.FunctionDecl, len(e.functions)*2)
+		for _, fn := range e.functions {
+			for _, o := range fn.OverloadDecls() {
+				idx[o.ID()] = fn
+			}
+		}
+		e.oidToFn = idx
+	})
+	return e.oidToFn
+}
+
