--- a/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/composition.go
+++ b/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/composition.go
@@ -38,6 +38,16 @@ import (
 
 const variablesTypeName = "kubernetes.variables"
 
+// emptyVariablesMap is the singleton empty `variables` ref.Val returned by
+// compositionContext.Variables for compilers built via NewSimpleCompiler.
+// It is constructed once at package init and is safe to share across requests:
+// lazy.MapValue exposes only read paths, and a zero-variable policy can never
+// legally reference `variables.x` (that is a compile error).
+var emptyVariablesMap = func() ref.Val {
+	emptyType := apiservercel.NewObjectType(variablesTypeName, map[string]*apiservercel.DeclField{})
+	return lazy.NewMapValue(emptyType)
+}()
+
 // CompositedCompiler compiles expressions with variable composition.
 type CompositedCompiler struct {
 	Compiler
@@ -104,6 +114,46 @@ func NewCompositedCompiler(envSet *environment.EnvSet) (*CompositedCompiler, err
 	}, nil
 }
 
+// NewSimpleCompiler returns a CompositedCompiler tailored for policies that
+// declare no `variables`. Relative to NewCompositedCompiler it skips:
+//
+//   - the per-policy `variables` Extend (two cel-go env clones, plus an extra
+//     link in the apiservercel type-provider chain consulted at every lookup),
+//   - the mutable `mapType` on the composition state (left nil as the sentinel
+//     meaning "composition disabled"), and
+//   - the per-request lazy.MapValue allocation in compositionContext.Variables
+//     (a process-wide empty map is returned instead).
+//
+// Callers MUST NOT call CompileAndStoreVariables / CompileAndStoreVariable on
+// the returned compiler — there is no mapType to register fields on. Aside from
+// the absence of the `variables` identifier in scope, CompileCondition /
+// CompileMutatingEvaluator behave identically to the NewCompositedCompiler
+// path, which is sound because a zero-variable policy cannot reference
+// `variables` without a compile error.
+func NewSimpleCompiler(envSet *environment.EnvSet) (*CompositedCompiler, error) {
+	state := &compositionState{
+		EnvSet:            envSet,
+		mapType:           nil, // sentinel: composition disabled
+		compiledVariables: map[string]CompilationResult{},
+	}
+
+	// Key the cached compiler by the *base* env template (envSet), exactly as
+	// NewCompositedCompiler does, so the two share entries in the process-wide
+	// program cache for expressions that don't reference `variables`. No
+	// variableSigFn is wired: these compilers cannot reference `variables`, so
+	// the cache key correctly omits the (always-empty) variable signature.
+	baseCompiler := newCachedCompiler(state.EnvSet, envSet)
+
+	conditionCompiler := &conditionCompiler{baseCompiler}
+	mutation := &mutatingCompiler{baseCompiler}
+	return &CompositedCompiler{
+		Compiler:          baseCompiler,
+		ConditionCompiler: conditionCompiler,
+		MutatingCompiler:  mutation,
+		state:             state,
+	}, nil
+}
+
 // NewCompositedCompilerForTypeChecking creates a CompositedCompiler for type checking.
 // It initializes the composition state but leaves the Compilers nil, as they are expected
 // to be replaced by the caller (who is doing type checking).
@@ -233,6 +283,13 @@ type compositionContext struct {
 }
 
