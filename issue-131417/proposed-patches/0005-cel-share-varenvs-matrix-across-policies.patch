From: VAP Memory Optimization <noreply@example.com>
Subject: [PATCH] cel: hoist mustBuildEnvs to a process-wide template-keyed pool

Even after patches 0001/0002, policies whose `variables` signatures differ each
recompute the 8-env `OptionalVariableDeclarations` matrix from scratch — 8
cel-go env clones per compiler whose function/library/declType machinery is
byte-for-byte identical across thousands of policies.

This patch moves the per-(template, opts) env construction into a process-wide
pool keyed by env template pointer, materialized lazily under sync.Once. The
per-policy `variables` declaration is then applied as a thin Extend on top of
the shared matrix entry.

Pre-patch flow:
  template -> Extend({variables}) -> 8 EnvSet.Extend (per-policy)
  = 9 Extends per policy; everything per-policy.

Post-patch flow:
  template -> 8 EnvSet.Extend (process-wide, shared) -> Extend({variables}) (per-policy)
  = 8 + K + N Extends total, where K is the number of distinct variable
  signatures across the cluster.

The set of declarations in the resulting env is unchanged in either ordering:
in both flows the final env contains
  (template) ∪ (opts decls) ∪ (variables decl) ∪ (declTypes).
cel-go treats added options as additive and order-independent for declarations
of disjoint names, so the type-checked output is identical.

Stacks naturally on top of patch 0004 (Lazy varEnvs). Where 0004 made the
matrix per-compiler-lazy, this patch makes it process-wide-shared.

Estimated savings: 2–6 GiB on a 10,000-policy cluster with 100 distinct
variable signatures.

---
 .../apiserver/pkg/admission/plugin/cel/compile.go      | 25 +++++++++++++++--
 .../pkg/admission/plugin/cel/compile_matrix_pool.go    | 80 ++++++++++++++++++
 .../apiserver/pkg/admission/plugin/cel/composition.go  | 18 +++++++++--
 3 files changed, 117 insertions(+), 6 deletions(-)

diff --git a/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/compile.go b/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/compile.go
--- a/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/compile.go
+++ b/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/compile.go
@@ -154,6 +154,12 @@ type Compiler interface {
 }

 type compiler struct {
+	// sharedMatrix, when non-nil, indicates this compiler delegates per-(opts)
+	// env construction to the process-wide pool keyed by templateID. The
+	// per-policy variables declaration (if any) is applied on top of the
+	// shared entry inside envFor.
+	sharedMatrix *sharedVarEnvsPool
+
 	// base / namespace / request feed lazy varEnvs construction.
 	base      *environment.EnvSet
 	namespace *apiservercel.DeclType
@@ -188,6 +194,9 @@ type compiler struct {
 	// composition path (no "variables" identifier in scope).
 	variableSigFn func() string
+
+	// variablesOverlay carries the per-policy `variables` declaration that
+	// must be Extended on top of any shared matrix entry. nil for policies
+	// with no variables (see patch 0006).
+	variablesOverlay *environment.VersionedOptions
 }

 func (c *compiler) envFor(opts OptionalVariableDeclarations) (*environment.EnvSet, error) {
+	if c.sharedMatrix != nil {
+		shared, err := c.sharedMatrix.envFor(opts)
+		if err != nil {
+			return nil, err
+		}
+		if c.variablesOverlay == nil {
+			return shared, nil
+		}
+		// Apply the per-policy variables overlay on top of the shared entry.
+		// This single Extend is the only per-policy work in the env path.
+		return shared.Extend(*c.variablesOverlay)
+	}
+
+	// Fallback: per-compiler-only lazy table (patch 0004 path).
 	if v, ok := c.envs.Load(opts); ok {
 		return v.(*environment.EnvSet), nil
 	}
diff --git a/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/compile_matrix_pool.go b/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/compile_matrix_pool.go
new file mode 100644
--- /dev/null
+++ b/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/compile_matrix_pool.go
@@ -0,0 +1,80 @@
+/*
+Copyright 2026 The Kubernetes Authors.
+Licensed under the Apache License, Version 2.0.
+*/
+
+package cel
+
+import (
+	"sync"
+
+	apiservercel "k8s.io/apiserver/pkg/cel"
+	"k8s.io/apiserver/pkg/cel/environment"
+)
+
+// sharedVarEnvsPool is a process-wide cache of the 8-entry
+// OptionalVariableDeclarations matrix, keyed by env-template pointer identity.
+//
+// Two policies built from the same env template share the same matrix
+// regardless of their `variables` declarations. Per-policy variables are
+// applied as a thin Extend on top of the shared entry inside compiler.envFor.
+//
+// Pointer identity is sufficient because the only production caller is the
+// `sync.Once`-guarded singleton in the validating plugin
+// (`getCompositionEnvTemplateWithStrictCost()`); tests that build per-test
+// templates accumulate small entries with no correctness risk.
+type sharedVarEnvsPool struct {
+	base      *environment.EnvSet
+	namespace *apiservercel.DeclType
+	request   *apiservercel.DeclType
+
+	envs sync.Map // OptionalVariableDeclarations -> *environment.EnvSet
+	once sync.Map // OptionalVariableDeclarations -> *sync.Once
+}
+
+var (
+	matrixPoolCache sync.Map // *environment.EnvSet (template) -> *sharedVarEnvsPool
+)
+
+// sharedMatrixForTemplate returns the (lazily-initialized) pool keyed by the
+// given template pointer. Safe for concurrent use.
+func sharedMatrixForTemplate(template *environment.EnvSet) *sharedVarEnvsPool {
+	if v, ok := matrixPoolCache.Load(template); ok {
+		return v.(*sharedVarEnvsPool)
+	}
+	pool := &sharedVarEnvsPool{
+		base:      template,
+		namespace: BuildNamespaceType(),
+		request:   BuildRequestType(),
+	}
+	actual, _ := matrixPoolCache.LoadOrStore(template, pool)
+	return actual.(*sharedVarEnvsPool)
+}
+
+// envFor returns the shared (template, opts) EnvSet, materializing it once.
+func (p *sharedVarEnvsPool) envFor(opts OptionalVariableDeclarations) (*environment.EnvSet, error) {
+	if v, ok := p.envs.Load(opts); ok {
+		return v.(*environment.EnvSet), nil
+	}
+	onceI, _ := p.once.LoadOrStore(opts, &sync.Once{})
+	var buildErr error
+	onceI.(*sync.Once).Do(func() {
+		es, err := createEnvForOpts(p.base, p.namespace, p.request, opts)
+		if err != nil {
+			buildErr = err
+			return
+		}
+		p.envs.Store(opts, es)
+	})
+	if buildErr != nil {
+		p.once.Delete(opts)
+		return nil, buildErr
+	}
+	v, _ := p.envs.Load(opts)
+	return v.(*environment.EnvSet), nil
+}
+
+// SharedMatrixSizeForTests reports the number of materialized entries in the
+// matrix for the given template. Test-only.
+func SharedMatrixSizeForTests(template *environment.EnvSet) int {
+	v, ok := matrixPoolCache.Load(template)
+	if !ok {
+		return 0
+	}
+	pool := v.(*sharedVarEnvsPool)
+	count := 0
+	pool.envs.Range(func(_, _ any) bool { count++; return true })
+	return count
+}
diff --git a/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/composition.go b/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/composition.go
--- a/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/composition.go
+++ b/staging/src/k8s.io/apiserver/pkg/admission/plugin/cel/composition.go
@@ -65,11 +65,12 @@ type CompositedEvaluator struct {
 }

 func NewCompositedCompiler(envSet *environment.EnvSet) (*CompositedCompiler, error) {
 	newMapType := apiservercel.NewObjectType(variablesTypeName, map[string]*apiservercel.DeclField{})
-
-	newEnvSet, err := envSet.Extend(environment.VersionedOptions{
+	// Capture the variables overlay declaratively rather than eagerly extending.
+	// The compiler will apply it on top of the shared (template, opts) matrix
+	// entry inside envFor, so two policies whose only difference is their
+	// `variables` declarations still share the underlying 8-env matrix.
+	variablesOverlay := environment.VersionedOptions{
 		IntroducedVersion: version.MajorMinor(1, 0),
 		EnvOptions: []cel.EnvOption{
 			cel.Variable("variables", newMapType.CelType()),
 		},
 		DeclTypes: []*apiservercel.DeclType{
 			newMapType,
 		},
-	})
-	if err != nil {
-		return nil, err
 	}

 	state := &compositionState{
 		mapType:           newMapType,
-		EnvSet:            newEnvSet,
+		EnvSet:            envSet, // base; the per-policy variables overlay is on the compiler
 		compiledVariables: map[string]CompilationResult{},
 	}

 	// The cached compiler now uses the shared matrix pool keyed by envSet
 	// (the template). The variables overlay is applied per-call inside envFor.
 	baseCompiler := newCachedCompiler(envSet, envSet)
+	baseCompiler.sharedMatrix = sharedMatrixForTemplate(envSet)
+	baseCompiler.variablesOverlay = &variablesOverlay
 	baseCompiler.variableSigFn = state.variableSignature

 	conditionCompiler := &conditionCompiler{baseCompiler}
