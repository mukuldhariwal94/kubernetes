+		// from the cached entry; it is rebound on each cache hit above.
+		compileCache().Add(key, CompilationResult{
+			Program:    cr.Program,
+			OutputType: cr.OutputType,
+		})
+	}
+	recordCacheMiss()
+	return cr
+}
